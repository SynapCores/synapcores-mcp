{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SynapCores/synapcores",
  "title": "SynapCores",
  "description": "AI-native database: SQL, vector search, Cypher graph, AutoML and LLM tools over MCP.",
  "websiteUrl": "https://synapcores.com",
  "repository": {
    "url": "https://github.com/SynapCores/synapcores-mcp",
    "source": "github"
  },
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@synapcores/mcp",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SYNAPCORES_URL",
          "description": "SynapCores gateway URL, e.g. http://127.0.0.1:8080",
          "isRequired": true,
          "isSecret": false,
          "default": "http://127.0.0.1:8080"
        },
        {
          "name": "SYNAPCORES_API_KEY",
          "description": "SynapCores API key (create with POST /v1/api-keys; use a ReadOnly key for read-only access)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
