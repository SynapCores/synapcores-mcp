{
  "source": "SynapCores CE 2.4.8 gateway, POST /v1/mcp tools/list",
  "tools": [
    {
      "name": "describe_table",
      "description": "Get detailed schema information for a table including columns and constraints.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "table": {
            "type": "string",
            "description": "Table name"
          },
          "database": {
            "type": "string",
            "description": "Database name (optional)"
          },
          "include_samples": {
            "type": "boolean",
            "description": "Include sample values for each column (default: false)",
            "default": false
          }
        },
        "required": [
          "table"
        ]
      }
    },
    {
      "name": "execute",
      "description": "Execute DML (INSERT/UPDATE/DELETE) or DDL (CREATE/ALTER/DROP) statements.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sql": {
            "type": "string",
            "description": "SQL statement to execute"
          },
          "database": {
            "type": "string",
            "description": "Database name (optional)"
          },
          "dry_run": {
            "type": "boolean",
            "description": "Validate without executing (default: false)",
            "default": false
          }
        },
        "required": [
          "sql"
        ]
      }
    },
    {
      "name": "list_tables",
      "description": "List all tables in the database.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string",
            "description": "Database name (optional, uses default)"
          },
          "pattern": {
            "type": "string",
            "description": "Filter pattern (SQL LIKE syntax)"
          },
          "include_system": {
            "type": "boolean",
            "description": "Include system tables (default: false)",
            "default": false
          }
        }
      }
    },
    {
      "name": "query",
      "description": "Execute a SELECT query and return results. Use this for reading data.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sql": {
            "type": "string",
            "description": "SQL SELECT query to execute"
          },
          "database": {
            "type": "string",
            "description": "Database name (optional, uses default if not specified)"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum rows to return (default: 1000, max: 10000)",
            "default": 1000
          },
          "offset": {
            "type": "integer",
            "description": "Number of rows to skip",
            "default": 0
          },
          "format": {
            "type": "string",
            "enum": [
              "rows",
              "markdown",
              "csv"
            ],
            "description": "Output format (default: rows)",
            "default": "rows"
          }
        },
        "required": [
          "sql"
        ]
      }
    },
    {
      "name": "sql_manual",
      "description": "Get SQL syntax documentation and examples for SynapCores AIDB.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "description": "Topic to look up (e.g., 'SELECT', 'CREATE TABLE', 'EMBED', 'COSINE_SIMILARITY')"
          },
          "category": {
            "type": "string",
            "enum": [
              "statements",
              "functions",
              "operators",
              "types",
              "all"
            ],
            "description": "Category to browse (default: all)",
            "default": "all"
          }
        }
      }
    },
    {
      "name": "validate_query",
      "description": "Validate SQL syntax without executing. Optionally returns execution plan.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sql": {
            "type": "string",
            "description": "SQL query to validate"
          },
          "include_plan": {
            "type": "boolean",
            "description": "Include execution plan (default: false)",
            "default": false
          }
        },
        "required": [
          "sql"
        ]
      }
    },
    {
      "name": "train_model",
      "description": "Train an AutoML model on a table column. Wraps CREATE EXPERIMENT - the LLM does not need to know SQL. Trains the model, registers it under `model_name`, and returns the best score and chosen algorithm. Subsequent `predict` calls reference it by `model_name`.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "description": "Table/collection name containing training data"
          },
          "target": {
            "type": "string",
            "description": "Column to predict"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional list of feature columns. Empty/omitted uses all columns except target."
          },
          "task_type": {
            "type": "string",
            "enum": [
              "binary_classification",
              "multiclass_classification",
              "regression",
              "classification"
            ],
            "description": "Task type (default: binary_classification)",
            "default": "binary_classification"
          },
          "max_trials": {
            "type": "integer",
            "description": "Number of AutoML trials (default: 3, higher = better but slower)",
            "default": 3
          },
          "model_name": {
            "type": "string",
            "description": "Optional model name (default: auto-generated as `{collection}_{target}_model`)"
          }
        },
        "required": [
          "collection",
          "target"
        ]
      }
    },
    {
      "name": "predict",
      "description": "Run a trained AutoML model against a list of input rows. Returns calibrated probabilities in [0, 1] for classification (positive-class probability) or numeric predictions for regression. v1.6.5 path: calibrated, polarity-correct.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model_name": {
            "type": "string",
            "description": "Model name (the one passed to `train_model`)"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Array of feature dicts, e.g. [{col1: v1, col2: v2}, ...]. All rows must have the same columns."
          },
          "return_proba": {
            "type": "boolean",
            "description": "Return probabilities (true, default) vs raw predictions (currently ignored - AIDB v1.6.5 always returns calibrated proba for classification).",
            "default": true
          }
        },
        "required": [
          "model_name",
          "inputs"
        ]
      }
    },
    {
      "name": "list_models",
      "description": "List all AutoML models trained by this tenant. Returns name, task type, accuracy, and creation timestamp. Pair with `describe_model` for full details.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task_type": {
            "type": "string",
            "description": "Optional filter: only return models with this task_type"
          },
          "status": {
            "type": "string",
            "description": "Optional filter: only return models with this status (default: deployed)",
            "default": "deployed"
          }
        }
      }
    },
    {
      "name": "describe_model",
      "description": "Get full details of a trained AutoML model: algorithm, hyperparameters, metrics, feature names, and feature importance.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model_name": {
            "type": "string",
            "description": "Model name (the one passed to `train_model`)"
          },
          "include_feature_importance": {
            "type": "boolean",
            "description": "Include feature importance scores (default: true)",
            "default": true
          }
        },
        "required": [
          "model_name"
        ]
      }
    },
    {
      "name": "semantic_search",
      "description": "Semantic / similarity search over a vector collection. The LLM does NOT need to know EMBED() or COSINE_SIMILARITY() SQL \u2014 this tool embeds the query, runs ANN/exact search, and returns the top-k matches by similarity.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "description": "Vector collection / space name"
          },
          "query_text": {
            "type": "string",
            "description": "Natural-language query to embed and search with"
          },
          "k": {
            "type": "integer",
            "description": "Top-K results to return (default: 10, max: 1000)",
            "default": 10
          },
          "filter": {
            "type": "object",
            "description": "Optional metadata equality predicates, e.g. {\"category\": \"electronics\"}. Applied client-side after search; for large collections, prefer pre-filtered queries."
          }
        },
        "required": [
          "collection",
          "query_text"
        ]
      }
    },
    {
      "name": "embed_text",
      "description": "Generate a vector embedding for a piece of text. Wraps EMBED() so the LLM doesn't need to know the SQL function.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Text to embed"
          },
          "model": {
            "type": "string",
            "enum": [
              "minilm",
              "bert-base",
              "bert-large"
            ],
            "description": "Embedding model (default: configured default - minilm)"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "graph_query",
      "description": "Run a Cypher query against the tenant's graph. Supports MATCH/MERGE/CREATE/SET/DELETE/UNWIND/UNION and `CALL gds.<algorithm>(...) YIELD ...` procedures.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string",
            "description": "Selected tenant database; defaults to main."
          },
          "cypher": {
            "type": "string",
            "description": "Cypher statement. Multiple `;`-separated statements supported."
          },
          "params": {
            "type": "object",
            "description": "Parameters (currently informational only \u2014 inline literals work as expected; parameterized bindings land in v1.6.6)."
          },
          "graph_name": {
            "type": "string",
            "description": "Reserved for multi-graph tenants. Currently always the tenant's default graph."
          }
        },
        "required": [
          "cypher"
        ]
      }
    },
    {
      "name": "generate_text",
      "description": "Generate text from a prompt using the gateway's configured LLM. Wraps GENERATE() / the AI service manager so the LLM can chain generation into multi-step workflows (e.g. summarize predict() output).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Prompt text"
          },
          "model": {
            "type": "string",
            "description": "Optional model override (default: gateway's configured completion model)"
          },
          "max_tokens": {
            "type": "integer",
            "description": "Max tokens to generate (default: 100)",
            "default": 100
          },
          "temperature": {
            "type": "number",
            "description": "Sampling temperature (default: 0.7)",
            "default": 0.7
          }
        },
        "required": [
          "prompt"
        ]
      }
    },
    {
      "name": "agent_soul",
      "description": "Inspect the current tenant/database's learned memory, episodes, rewards, runs, plans, goals, skills, policy or audit. Administrator required; read-only, paginated, no execution.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "database",
          "section"
        ],
        "properties": {
          "database": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "section": {
            "type": "string",
            "enum": [
              "memory",
              "episodes",
              "rewards",
              "runs",
              "plans",
              "plan_steps",
              "goals",
              "skills",
              "policy",
              "audit",
              "tenant_fence",
              "tenant_audit"
            ]
          },
          "after": {
            "type": "string",
            "maxLength": 1024
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          }
        }
      }
    }
  ]
}
